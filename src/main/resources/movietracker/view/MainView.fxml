<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="movietracker.ui.MainController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <top>
        <VBox spacing="8.0">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="Movie Tracker" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
                <Region HBox.hgrow="ALWAYS" />
                <Button text="Search" onAction="#handleShowSearch" />
                <Button text="Watchlist" onAction="#handleShowWatchlist" />
                <Button text="Watched" onAction="#handleShowWatched" />
            </HBox>
            <Label fx:id="storageFeedbackLabel"
                   managed="false"
                   visible="false"
                   wrapText="true"
                   style="-fx-text-fill: #9a3412; -fx-background-color: #ffedd5; -fx-padding: 8px;" />
        </VBox>
    </top>
    <center>
        <StackPane>
            <VBox fx:id="searchView" spacing="16.0">
            <HBox spacing="8.0">
                <TextField fx:id="searchField"
                           HBox.hgrow="ALWAYS"
                           promptText="Search by movie title"
                           onAction="#handleSearch" />
                <Button fx:id="searchButton" text="Search" onAction="#handleSearch" />
            </HBox>
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                <ProgressIndicator fx:id="loadingIndicator" prefHeight="22.0" prefWidth="22.0" />
                <Label fx:id="feedbackLabel"
                       text="Enter a movie title or keyword to search."
                       wrapText="true" />
                </HBox>
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="resultsBox" spacing="10.0" />
                    </content>
                </ScrollPane>
            </VBox>
            <VBox fx:id="detailsView" spacing="16.0" visible="false" managed="false">
                <Button fx:id="backButton"
                        text="Back to search results"
                        onAction="#handleBackToResults" />
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <ProgressIndicator fx:id="detailsLoadingIndicator"
                                       prefHeight="22.0"
                                       prefWidth="22.0" />
                    <Label fx:id="detailsFeedbackLabel" wrapText="true" />
                </HBox>
                <Label fx:id="detailsTitleLabel"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"
                       wrapText="true" />
                <Label fx:id="detailsReleaseDateLabel" wrapText="true" />
                <Label fx:id="detailsRatingLabel" wrapText="true" />
                <Label text="Overview" style="-fx-font-size: 16px; -fx-font-weight: bold;" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox>
                            <Label fx:id="detailsOverviewLabel"
                                   maxWidth="Infinity"
                                   wrapText="true" />
                        </VBox>
                    </content>
                </ScrollPane>
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Button fx:id="addToWatchlistButton"
                            text="Add to Watchlist"
                            onAction="#handleAddToWatchlist" />
                    <Label fx:id="watchlistActionLabel" wrapText="true" />
                </HBox>
            </VBox>
            <VBox fx:id="watchlistView" spacing="16.0" visible="false" managed="false">
                <Label text="Watchlist"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label fx:id="watchlistFeedbackLabel"
                       text="Your watchlist is empty."
                       wrapText="true" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="watchlistBox" spacing="10.0" />
                    </content>
                </ScrollPane>
            </VBox>
            <VBox fx:id="watchedView" spacing="16.0" visible="false" managed="false">
                <Label text="Watched"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;" />
                <Label fx:id="watchedFeedbackLabel"
                       text="You have not marked any movies as watched."
                       wrapText="true" />
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                    <content>
                        <VBox fx:id="watchedBox" spacing="10.0" />
                    </content>
                </ScrollPane>
            </VBox>
        </StackPane>
    </center>
</BorderPane>
