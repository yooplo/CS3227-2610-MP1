<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="movietracker.ui.MainController">
    <padding>
        <Insets top="24.0" right="24.0" bottom="24.0" left="24.0" />
    </padding>
    <top>
        <VBox spacing="16.0">
            <Label text="Movie Tracker" style="-fx-font-size: 28px; -fx-font-weight: bold;" />
            <HBox spacing="8.0">
                <TextField fx:id="searchField"
                           HBox.hgrow="ALWAYS"
                           promptText="Search by movie title"
                           onAction="#handleSearch" />
                <Button fx:id="searchButton" text="Search" onAction="#handleSearch" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <ProgressIndicator fx:id="loadingIndicator" prefHeight="22.0" prefWidth="22.0" />
                <Label fx:id="feedbackLabel"
                       text="Enter a movie title or keyword to search."
                       wrapText="true" />
            </HBox>
        </VBox>
    </top>
    <center>
        <ScrollPane fitToWidth="true">
            <content>
                <VBox fx:id="resultsBox" spacing="10.0">
                    <padding>
                        <Insets top="16.0" />
                    </padding>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
